# کپی کنید به .env و مقادیر را تغییر دهید
DB_HOST=db
DB_PORT=3306
DB_NAME=api
DB_USER=api
DB_PASS=change-me

# حداقل ۳۲ کاراکتر. تولید: openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=http://localhost:10103
JWT_TTL=1200

# فقط برای مرورگر/فرانت روی دامنه‌ی دیگر؛ مقدار * یا آدرس مشخص
CORS_ALLOW_ORIGIN=
